OPENROUTER_API_KEY=sk-or-xxxxxxxx
JWT_SECRET=weka-maneno-marefu-ya-siri
ADMIN_KEY=weka-nenosiri-la-admin
USD_TZS=2600
MARKUP=4
FREE_DAILY=6
ANON_DAILY=3
PAY_INFO=Tuma pesa kwa Lipa Namba XXXXXX (Ant Lab Eco Service) kisha weka namba ya muamala
# Hiari: orodha ya modeli (comma separated). Mfumo huchagua ya bei nafuu zaidi kwa wakati halisi.
# ECO_MODELS=google/gemini-2.0-flash-001,openai/gpt-4o-mini,deepseek/deepseek-chat
# PRO_MODELS=google/gemini-2.5-flash,openai/gpt-4.1-mini
# DB_PATH=/data/mlimani.db

# Modeli za BURE kwanza (MVP). Weka FREE_FIRST=false ukitaka kulipia moja kwa moja.
FREE_FIRST=true
# Hiari: orodha yako ya modeli za bure; ukiiacha, mfumo huchagua yenyewe zenye ":free"
# FREE_MODELS=meta-llama/llama-3.3-70b-instruct:free,google/gemini-2.0-flash-exp:free

# Picha bure kwa siku (kwa mtu mmoja)
IMG_ANON_DAILY=1
IMG_FREE_DAILY=2
IMG_PAID_DAILY=20

# Picha/video bila alama ya Pollinations: pata ufunguo wa bure kwenye enter.pollinations.ai
POLLINATIONS_API_KEY=
# Chaguo la video: pollinations (default) au openrouter (matumizi yanaweza kutozwa)
VIDEO_PROVIDER=pollinations
OPENROUTER_VIDEO_MODEL=bytedance/seedance-2.0
OPENROUTER_VIDEO_RESOLUTION=720p
# OPENROUTER_API_KEY tayari inatumika kwa AI Chat; video ya OpenRouter hutumia key hiyo hiyo.
VIDEO_MODEL=seedance
VIDEO_COST_TZS=1500
VIDEO_DAILY=5
# LiveAvatar: weka key na avatar IDs ulizopewa na akaunti yako ya LiveAvatar
LIVEAVATAR_API_KEY=
LIVEAVATAR_ETHAN_AVATAR_ID=
LIVEAVATAR_NGINA_AVATAR_ID=
# API keys za integrations zijazo (usiweke mpaka adapter husika ijengwe na kujaribiwa)
# ELEVENLABS_API_KEY=
# CARTESIA_API_KEY=
# DEEPGRAM_API_KEY=
# REPLICATE_API_TOKEN=
# STABILITY_API_KEY=
# RUNWAY_API_KEY=
# LUMA_API_KEY=
# HEYGEN_API_KEY=
# DID_API_KEY=

# Taarifa ya malipo mapya kwa Telegram (tengeneza bot kwa @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Hiari: callback ya lango la malipo
WEBHOOK_SECRET=

# Miunganisho (GitHub/Render): ufunguo wa usimbaji wa tokens. Tengeneza kwa:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
PLUGIN_PLANS=free,kawaida,biashara,kampuni
# Mlimani Fleet connector base URL (custom domain)
MLIMANI_FLEET_URL=https://app.mlimani.net

# Plugins: mipango inayoruhusiwa
BUILTIN_PLANS=free,kawaida,biashara,kampuni
# Composio: Free inaruhusiwa kwa toolkit za kawaida zilizoorodheshwa; kikomo cha kila mtumiaji ni 100 calls/mwezi na kikomo cha pamoja ni 8,000 calls/mwezi.
# Instant Tools zenye gharama za mtoa huduma haziruhusiwi kwa Free. Kila plugin: authConfigId (kutoka dashboard ya Composio),
# tools (slugs za zana), write (zana zinazoandika, zinaomba ruhusa). Mfano:
# COMPOSIO_PLANS=free,kawaida,biashara,kampuni
# COMPOSIO_FREE_PLUGINS=google_drive,google_calendar,google_sheets,slack,notion,canva,salesforce
# COMPOSIO_FREE_USER_MONTHLY=100
# COMPOSIO_FREE_GLOBAL_MONTHLY=8000
# COMPOSIO_API_KEY=
# COMPOSIO_PLUGINS=[{"id":"google_calendar","authConfigId":"ac_xxx","tools":["GOOGLECALENDAR_EVENTS_LIST","GOOGLECALENDAR_CREATE_EVENT"],"write":["GOOGLECALENDAR_CREATE_EVENT"]}]
VAT_RATE=0.18
